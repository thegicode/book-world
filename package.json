{
    "name": "book-world",
    "version": "1.0.0",
    "description": "",
    "main": "server/index",
    "scripts": {
        "start": "npm run start-dev",
        "start-dev": "npm run work & NODE_ENV=development node server/dist",
        "start-prod": "npm run build & NODE_ENV=production node server/dist",
        "work": "concurrently \"npm:watch:assets\" \"npm:tsc\" \"npm:esbuild-dev\"",
        "watch:assets": "nodemon --watch app/src/markup --watch app/src/scss --ext html,scss --exec \"npm run build-assets\"",
        "build": "NODE_ENV=production npm run build-assets",
        "build-assets": "ts-node --project tsconfig.scripts.json server/src/scripts/build-assets.ts",
        "test": "vitest run",
        "test:watch": "vitest",
        "tsc": "npx tsc -w & npx tsc --project ./server/src",
        "esbuild-dev": "NODE_ENV=development node esbuild.config.js",
        "eslint": "eslint app --ext .ts"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/thegicode/book-world.git"
    },
    "author": "thegi.code@gmail.com",
    "license": "ISC",
    "bugs": {
        "url": "https://github.com/thegicode/book-world/issues"
    },
    "homepage": "https://github.com/thegicode/book-world#readme",
    "devDependencies": {
        "@babel/core": "^7.21.4",
        "@babel/parser": "^7.21.4",
        "@babel/preset-env": "^7.21.4",
        "@babel/preset-typescript": "^7.21.4",
        "@babel/types": "^7.21.4",
        "@types/babel__core": "^7.20.0",
        "@types/babel__generator": "^7.6.4",
        "@types/babel__template": "^7.4.1",
        "@types/babel__traverse": "^7.18.3",
        "@types/express": "^4.17.17",
        "@types/fs-extra": "^11.0.1",
        "@types/node": "^18.16.3",
        "@typescript-eslint/eslint-plugin": "^5.55.0",
        "@typescript-eslint/parser": "^5.55.0",
        "cheerio": "^1.0.0-rc.12",
        "chokidar": "^3.5.3",
        "concurrently": "^8.0.1",
        "critical": "^7.2.1",
        "dotenv": "^16.0.3",
        "esbuild": "^0.17.13",
        "eslint": "^8.36.0",
        "eslint-config-airbnb": "^19.0.4",
        "eslint-plugin-typescript": "^0.14.0",
        "express": "^4.17.3",
        "fs-extra": "^11.1.1",
        "glob": "^10.3.10",
        "html-minifier-terser": "^7.1.0",
        "install": "^0.13.0",
        "jsdom": "^28.1.0",
        "nodemon": "^2.0.22",
        "npm": "^9.6.3",
        "sass": "^1.49.9",
        "sharp": "^0.34.5",
        "ts-node": "^10.9.1",
        "vitest": "^4.0.18"
    },
    "dependencies": {
        "express-validator": "^7.3.1",
        "intersection-observer": "^0.12.2",
        "typescript": "^4.5.4"
    }
}
